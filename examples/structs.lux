// structs.lux —— 0.7 的 struct 结构体
// 编译运行： luxc examples/structs.lux --run
// 原生后端： luxc --native examples/structs.lux --run

struct Point {
    let x: int;
    let y: int;
}

struct Segment {
    let a: Point;
    let b: Point;
    let label: string;
    let weight: float;
}

fn manhattan(p: Point, q: Point) -> int {
    let dx = p.x - q.x;
    let dy = p.y - q.y;
    return if dx < 0 { -dx } else { dx } + if dy < 0 { -dy } else { dy };
}

fn translate(p: Point, dx: int, dy: int) {
    // struct 是引用语义：函数内改字段，调用方看得见
    p.x += dx;
    p.y += dy;
}

fn main() {
    let origin = Point { x: 0, y: 0 };
    let p = Point { x: 3, y: -4 };

    println(origin);
    println(p);
    println(manhattan(origin, p));

    translate(p, 10, 10);
    println(p);

    let s = Segment { a: origin, b: p, label: "ab", weight: 2.5 };
    println(s);
    println(s.a.x + s.b.y);
    println(s.label);

    // struct 数组 + 成员读写
    let path = [Point { x: 1, y: 1 }, Point { x: 2, y: 4 }, Point { x: 3, y: 9 }];
    println(path);
    path[1].y = 100;
    path[2].x += 7;
    println(path);
}
