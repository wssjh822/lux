// ============================================================
//  fizzbuzz.lux —— 经典 FizzBuzz
// ============================================================

fn fizzbuzz(n: int) -> string {
    if n % 15 == 0 {
        return "FizzBuzz";
    } else if n % 3 == 0 {
        return "Fizz";
    } else if n % 5 == 0 {
        return "Buzz";
    }
    return string(n);
}

fn main() {
    for i in 1..=20 {
        println(fizzbuzz(i));
    }
}
