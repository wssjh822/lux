// net_http.lux —— 用 httpx 包发一个 HTTP 请求（1.2）
// 先安装包： luxc install httpx
// 运行：     luxc examples/net_http.lux --run
// 注意：httpx 无 TLS，URL 必须以 http:// 开头。
import "httpx";
import "string";

fn main() {
    let r = get("http://example.com/")!;
    println("状态：" + string(r.status) + " " + r.reason);
    println("Content-Type：" + (header(r, "Content-Type") or "?"));
    println("正文长度：" + string(len(r.body)));
    let lines = split(r.body, "\n");
    let n = len(lines);
    if n > 5 {
        n = 5;
    }
    for i in 0..n {
        println(lines[i]);
    }
}
