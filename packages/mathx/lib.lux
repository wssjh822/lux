// ============================================================
//  mathx —— Lux 官方包示例：数论 / 数值小工具
//  安装： luxc install mathx
//  使用： import "mathx";
// ============================================================

// 最大公约数（欧几里得算法，输入取绝对值）
fn gcd(a: int, b: int) -> int {
    let x = abs(a);
    let y = abs(b);
    while y != 0 {
        let t = x % y;
        x = y;
        y = t;
    }
    return x;
}

// 最小公倍数；任一为 0 时返回 0
fn lcm(a: int, b: int) -> int {
    if a == 0 { return 0; }
    if b == 0 { return 0; }
    return abs(a / gcd(a, b) * b);
}

// 把 x 夹到 [lo, hi]
fn clampf(x: float, lo: float, hi: float) -> float {
    if x < lo { return lo; }
    if x > hi { return hi; }
    return x;
}

// 整数版 clamp
fn clampi(x: int, lo: int, hi: int) -> int {
    if x < lo { return lo; }
    if x > hi { return hi; }
    return x;
}

// 试除法判素数
fn is_prime(n: int) -> bool {
    if n < 2 { return false; }
    if n % 2 == 0 { return n == 2; }
    let i = 3;
    while i * i <= n {
        if n % i == 0 { return false; }
        i = i + 2;
    }
    return true;
}

// n!（n < 0 视作 0）
fn factorial(n: int) -> int {
    let r = 1;
    let i = 2;
    while i <= n {
        r = r * i;
        i = i + 1;
    }
    return r;
}

// 返回 [lo, hi) 内所有素数的个数（埃氏筛的朴素版）
fn count_primes(lo: int, hi: int) -> int {
    let n = 0;
    let i = lo;
    while i < hi {
        if is_prime(i) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

// 符号函数：负数 -1，0 返回 0，正数 1
fn sign(x: int) -> int {
    if x < 0 { return -1; }
    if x > 0 { return 1; }
    return 0;
}

// 偶数判定
fn is_even(n: int) -> bool {
    return n % 2 == 0;
}

// 奇数判定
fn is_odd(n: int) -> bool {
    return n % 2 != 0;
}

// 整数幂：ipow(b, e) = b^e（e < 0 返回 0；快速幂，O(log e)）
fn ipow(b: int, e: int) -> int {
    if e < 0 { return 0; }
    let r = 1;
    let base = b;
    let n = e;
    while n > 0 {
        if n % 2 == 1 { r = r * base; }
        base = base * base;
        n = n / 2;
    }
    return r;
}

// 十进制各位数字之和（取绝对值）
fn digit_sum(n: int) -> int {
    let x = abs(n);
    let s = 0;
    while x > 0 {
        s = s + x % 10;
        x = x / 10;
    }
    return s;
}
