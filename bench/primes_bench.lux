// ============================================================
//  primes.lux —— 试除法找素数，顺带展示 Lux 的运算性能
//  编译运行: luxc primes.lux -O3 --run
// ============================================================

const LIMIT: int = 2000000;

fn is_prime(n: int) -> bool {
    if n < 2 {
        return false;
    }
    if n == 2 {
        return true;
    }
    if n % 2 == 0 {
        return false;
    }
    let i = 3;
    while i * i <= n {
        if n % i == 0 {
            return false;
        }
        i = i + 2;
    }
    return true;
}

fn count_primes(limit: int) -> int {
    let count = 0;
    for n in 2..=limit {
        if is_prime(n) {
            count = count + 1;
        }
    }
    return count;
}

fn main() {
    let total = count_primes(LIMIT);
    println("2.." + string(LIMIT) + " 之间共有 " + string(total) + " 个素数");

    print("前 20 个素数: ");
    let found = 0;
    let n = 2;
    while found < 20 {
        if is_prime(n) {
            print(n);
            print(" ");
            found = found + 1;
        }
        n = n + 1;
    }
    println("");
}
