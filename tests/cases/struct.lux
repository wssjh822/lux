// 0.7：struct 声明 / 构造 / 成员读写 / 嵌套 / struct 数组 / 方法式传参
struct Point {
    let x: int;
    let y: int;
}

struct Line {
    let a: Point;
    let b: Point;
    let tag: string;
    let w: float;
}

fn mid_x(l: Line) -> float {
    return float(l.a.x + l.b.x) / 2.0;
}

fn shift(p: Point, dx: int, dy: int) {
    p.x += dx;
    p.y += dy;
}

fn main() {
    let p = Point { x: 3, y: 4 };
    println(p);
    println(p.x * p.x + p.y * p.y);
    p.x = 10;
    p.x += 5;
    println(p.x);
    shift(p, -2, 1);
    println(p);

    let q = Point { y: 7, x: -1 };
    let l = Line { a: p, b: q, tag: "seg", w: 1.5 };
    println(l);
    println(l.a.x);
    println(l.tag);
    println(l.w);
    println(mid_x(l));

    // struct 数组 + 成员赋值 + 复合赋值
    let ps = [Point { x: 1, y: 2 }, Point { x: 3, y: 4 }];
    println(ps);
    ps[0].x = 100;
    ps[1].y += 10;
    println(ps);
    println(ps[0].x + ps[1].y);

    // 数组字段
    let grid = [[1, 2], [3, 4]];
    grid[0][1] = 9;
    grid[1][0] += 10;
    println(grid);
}
