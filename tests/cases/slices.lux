// 切片（0.6）：四种端点形式 + 含端点 ..= + 字符串切片 + 复制语义
fn main() {
    let a = [10, 20, 30, 40, 50];
    println(a[1..3]);
    println(a[1..=3]);
    println(a[..2]);
    println(a[2..]);
    println(a[..]);
    println(a[0..0]);

    // 复制语义：修改切片不影响原数组
    let m = a[1..3];
    m[0] = 999;
    println(a[1]);
    println(m[0]);

    let w = "hello, world";
    println(w[7..]);
    println(w[..5]);
    println(w[0..=4]);
    println("[" + w[3..3] + "]");
}
