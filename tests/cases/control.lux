// 分支与循环
fn grade(score: int) -> string {
    if score >= 90 { return "A"; }
    else if score >= 80 { return "B"; }
    else if score >= 60 { return "C"; }
    return "D";
}

fn main() {
    println(grade(95));
    println(grade(85));
    println(grade(65));
    println(grade(10));

    let sum = 0;
    let i = 0;
    while i < 5 {
        sum = sum + i;
        i = i + 1;
    }
    println(sum);

    sum = 0;
    for k in 1..=5 {
        sum = sum + k;
    }
    println(sum);

    sum = 0;
    for k in 0..10 {
        if k % 3 == 0 { continue; }
        sum = sum + k;
    }
    println(sum);

    let n = 0;
    loop {
        n = n + 3;
        if n > 10 { break; }
    }
    println(n);
}
