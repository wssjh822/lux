// 函数、递归、多参数、相互递归
fn add(a: int, b: int) -> int { return a + b; }
fn mul(a: int, b: int) -> int { return a * b; }

fn fact(n: int) -> int {
    if n <= 1 { return 1; }
    return n * fact(n - 1);
}

fn is_even(n: int) -> bool {
    if n == 0 { return true; }
    return is_odd(n - 1);
}
fn is_odd(n: int) -> bool {
    if n == 0 { return false; }
    return is_even(n - 1);
}

fn apply_twice(x: int, f: string) -> int {
    if f == "double" { return x * 2; }
    return x;
}

fn no_args() -> string { return "no args"; }

fn main() {
    println(add(3, 4));
    println(mul(3, 4));
    println(fact(10));
    println(is_even(10));
    println(is_odd(10));
    println(is_even(7));
    println(apply_twice(21, "double"));
    println(apply_twice(21, "none"));
    println(no_args());
    println(add(add(1, 2), add(3, 4)));
}
