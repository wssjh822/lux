// import 标准库模块 math
import "math";

fn main() {
    println(pi);
    println(pow(2.0, 10.0));
    println(sqrt(2.0));
    println(floor(3.7));
    println(ceil(3.2));
    println(round(2.5));
    println(sin(0.0));
    println(cos(0.0));
    println(log(exp(1.0)));
    println(log10(1000.0));
    println(max(3, 7));
    println(min(3, 7));
    println(max(2.5, 1.25));
    println(min(2.5, 1.25));
}
