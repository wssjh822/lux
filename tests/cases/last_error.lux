// 0.9.4（P1-5 / P1-8）：last_error() 错误消息通道 + find_opt 可选变体
import "string";
import "file";

fn main() {
    // find_opt：命中 / 未命中（未命中写 last_error）
    println(find_opt("hello world", "world") or -1);
    let miss = find_opt("hello", "zzz") or -1;
    println(miss);
    if miss >= 0 { println("hit"); } else { println("miss"); }
    println(last_error());

    // int / float 解析失败：T? 给不出原因，last_error() 补上
    println(int("abc") or 0);
    println(last_error());
    println(float("x") or 0.0);
    println(last_error());

    // read 失败：区分“不存在”与“没权限”——这是用户要的最小方案
    println(read("/no/such/lux-file-xyz") or "none");
    println(last_error());

    // 成功路径不覆盖错误：last_error() 语义是“最近一次失败”
    println(find_opt("abcdef", "cd") or -1);
    println(last_error());
}
